#!/bin/bash
# Both CPU suites, with the counts the handoff has to report. Scratch helper for
# the agent's verification step, not part of the experiment.
R=/users/jkli/Koopman_Mamba/.claude/worktrees/agent-a792063b1c582dab8
PY=/users/jkli/.venvs/koopman-cpu/bin/python
echo "=== suite A: optuna-enabled ==="
PYTHONPATH=$R:/users/jkli/.venvs/koopman-optuna/site $PY -m pytest "$R/code-tests" -q -p no:randomly 2>&1 \
    | grep -E "^(FAILED|ERROR)|passed|failed"
echo "=== suite B: no optuna ==="
PYTHONPATH=$R $PY -m pytest "$R/code-tests" -q -p no:randomly 2>&1 \
    | grep -E "^(FAILED|ERROR)|passed|failed"
