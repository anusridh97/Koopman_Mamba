{
  "schema_version": 1,
  "study_name": "echo-phase2a-1m-v1",
  "status": "premerge_infrastructure_only",
  "base_model_config": "configs/phase2a_1m_core.json",
  "scale": {
    "label": "1m-core",
    "accounting": "non_embedding_trainable_parameters",
    "target": 1000000,
    "accepted_min": 800000,
    "accepted_max": 1150000,
    "note": "A real 32000-token tied embedding adds 2.048M parameters. Total model size is therefore approximately 2.90M-3.15M. Both counts must be logged."
  },
  "protocol": {
    "tokenizer": "mistralai/Mistral-7B-v0.1",
    "tokenizer_revision": "REQUIRED_BEFORE_SCIENTIFIC_RUN",
    "train_dataset": "FineWeb-Edu",
    "train_dataset_revision": "REQUIRED_BEFORE_SCIENTIFIC_RUN",
    "validation_dataset": "WikiText-103",
    "validation_dataset_revision": "REQUIRED_BEFORE_SCIENTIFIC_RUN",
    "sequence_length": 2048,
    "effective_batch_sequences": 96,
    "seed": 42,
    "precision": "bf16",
    "optimizer": "AdamW",
    "adam_betas": [
      0.9,
      0.95
    ],
    "adam_epsilon": 1e-08,
    "fused_adamw": true,
    "base_learning_rate": 0.00001,
    "learning_rate_status": "provisional_team_confirmation_required",
    "weight_decay": 0.1,
    "weight_decay_exclusions": [
      "bias",
      "normalization_scale",
      "layerscale",
      "scalar_gate",
      "koopman_eigenvalue",
      "gamma_eta"
    ],
    "warmup_fraction": 0.02,
    "scheduler": "cosine",
    "minimum_learning_rate_ratio": 0.0,
    "max_gradient_norm": 1.0,
    "world_size": 1,
    "per_device_microbatch_sequences": 24,
    "gradient_accumulation_steps": 4,
    "gradient_checkpointing": false,
    "data_stream": {
      "sampler": "deterministic_global_sequence_index",
      "sampler_revision": "REQUIRED_BEFORE_SCIENTIFIC_RUN",
      "shuffle_seed": "REQUIRED_BEFORE_SCIENTIFIC_RUN",
      "shard_order_policy": "REQUIRED_BEFORE_SCIENTIFIC_RUN",
      "shard_order_manifest_sha256": "REQUIRED_BEFORE_SCIENTIFIC_RUN",
      "epoch_policy": "REQUIRED_BEFORE_SCIENTIFIC_RUN",
      "repeat_policy": "REQUIRED_BEFORE_SCIENTIFIC_RUN",
      "worker_partitioning": "global_sequence_index modulo world_size after deterministic ordering"
    },
    "loss_normalization": "mean_over_supervised_tokens_then_weighted_objective_sum",
    "optimizer_step_order": "clip_then_optimizer_then_scheduler",
    "training_protocol_status": "provisional_team_confirmation_required"
  },
  "fidelity": {
    "prune_step": 500,
    "max_steps": 6000,
    "checkpoint_steps": [
      500,
      2000,
      6000
    ],
    "pruner": "completed_trial_median",
    "prune_metric": "mqar_accuracy",
    "minimum_completed_trials": 20,
    "comparison_scope": "same_fidelity_and_architecture_mode"
  },
  "study": {
    "sampler": "TPESampler",
    "sampler_options": {
      "multivariate": true,
      "group": true
    },
    "sampler_seed": 42,
    "requested_trials": 2000,
    "controller_objective": {
      "name": "mqar_accuracy",
      "direction": "maximize",
      "reason": "Optuna native pruning is single-objective; WikiText PPL is retained as a user attribute and artifact."
    },
    "analysis_objectives": [
      {
        "name": "mqar_accuracy",
        "direction": "maximize"
      },
      {
        "name": "wikitext_ppl",
        "direction": "minimize"
      }
    ],
    "promotion_seeds": [
      42,
      43,
      44
    ],
    "compute_budget": {
      "maximum_total_gpu_hours": "REQUIRED_BEFORE_SCIENTIFIC_RUN",
      "maximum_full_trial_gpu_hours": "REQUIRED_BEFORE_SCIENTIFIC_RUN",
      "maximum_concurrent_trials": 16,
      "required_gpu_type": "REQUIRED_BEFORE_SCIENTIFIC_RUN",
      "failure_retry_reserve_fraction": 0.2,
      "status": "provisional_team_confirmation_required"
    }
  },
  "architecture_modes": {
    "updated_sweep": {
      "searched": true,
      "description": "The Scaling Echo updated beta-gated, LayerScale, short-conv architecture. This is the only mode in which beta_init is meaningful."
    },
    "paper_control": {
      "searched": false,
      "description": "Paper-semantics control at the 1M-core scale: paper_sequence_max normalization, no beta gate, two-sided whitening, K=2, epsilon=1e-3, with the explicitly frozen 25% middle-clustered layout below. This is not a literal Table 4 model-size/topology reproduction. Schedule separately at matched seeds."
    },
    "mamba_only": {
      "searched": false,
      "description": "No-SKA control with the same 16-layer 1M-core backbone and Koopman MLP channel mixers. Schedule separately at matched seeds."
    }
  },
