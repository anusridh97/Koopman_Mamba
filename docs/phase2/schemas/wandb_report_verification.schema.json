{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "echo.phase2.wandb_report_verification.schema.json",
  "title": "Echo Phase 2a W&B report verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "verification_status",
    "verification_method",
    "analysis_artifact",
    "study_identity",
    "wandb_report_url",
    "wandb_run_count",
    "wandb_run_ids",
    "verified_by",
    "verified_at_utc"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "phase2a_wandb_report_verification"
    },
    "verification_status": {
      "const": "verified"
    },
    "verification_method": {
      "const": "manual_wandb_report_run_set_audit"
    },
    "analysis_artifact": {
      "$ref": "#/$defs/artifact"
    },
    "study_identity": {
      "$ref": "#/$defs/studyIdentity"
    },
    "wandb_report_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://wandb[.]ai/(?:[^/]+/)+reports/.+$"
    },
    "wandb_run_count": {
      "type": "integer",
      "minimum": 1
    },
    "wandb_run_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verified_by": {
      "type": "string",
      "minLength": 1
    },
    "verified_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "sha256",
        "byte_size"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "studyIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_name",
        "spec_hash",
        "code_commit",
        "code_dirty",
        "data_hash",
        "capability_hash"
      ],
      "properties": {
        "study_name": {
          "type": "string",
          "minLength": 1
        },
        "spec_hash": {
          "$ref": "#/$defs/sha256"
        },
        "code_commit": {
          "type": "string",
          "minLength": 7
        },
        "code_dirty": {
          "const": false
        },
        "data_hash": {
          "$ref": "#/$defs/sha256"
        },
        "capability_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
