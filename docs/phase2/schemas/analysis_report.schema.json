{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "echo.phase2.analysis_report.schema.json",
  "title": "Echo Phase 2 offline analysis report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_identity",
    "trial_hash_index",
    "study_semantics",
    "pareto_front",
    "promotion_shortlist",
    "seeded_stability",
    "confirmed_promotion_shortlist",
    "retrospective_control_false_pruning_risk",
    "fanova_importance",
    "falsified_hypotheses",
    "wandb_report_payload"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "study_identity": {
      "$ref": "#/$defs/studyIdentity"
    },
    "trial_hash_index": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "study_semantics": {
      "type": "object",
      "required": [
        "optuna_controller_objective",
        "final_selection",
        "sampling_warning"
      ],
      "properties": {
        "optuna_controller_objective": {
          "const": "maximize_mqar_accuracy"
        },
        "final_selection": {
          "const": "posthoc_mqar_max_wikitext_ppl_min_pareto"
        },
        "sampling_warning": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pareto_front": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "promotion_shortlist": {
      "$ref": "#/$defs/promotionShortlist"
    },
    "seeded_stability": {
      "type": "object",
      "required": [
        "schema_version",
        "required_seeds",
        "configuration_count",
        "confirmed_configuration_count",
        "configurations",
        "confirmed_records"
      ]
    },
    "confirmed_promotion_shortlist": {
      "$ref": "#/$defs/confirmedPromotionShortlist"
    },
    "retrospective_control_false_pruning_risk": {
      "$ref": "#/$defs/retrospectiveControlFalsePruningRisk"
    },
    "fanova_importance": {
      "type": "object"
    },
    "falsified_hypotheses": {
      "$ref": "#/$defs/hypothesesReport"
    },
    "wandb_report_payload": {
      "$ref": "#/$defs/wandbPayload"
    }
  },
  "$defs": {
    "promotionShortlist": {
      "type": "object",
      "required": [
        "schema_version",
        "study_identity",
        "selection_policy",
        "candidate_counts",
        "selected"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "study_identity": {
          "$ref": "#/$defs/studyIdentity"
        },
        "selection_policy": {
          "type": "object"
        },
        "candidate_counts": {
          "type": "object"
        },
        "selected": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "promotion_rank",
              "selection_reason",
              "architecture_signature",
              "stability_evidence",
              "trial_hash",
              "promotion_config_hash",
              "seed",
              "parameters",
              "status",
              "health_passed"
            ]
          }
        }
      }
    },
    "confirmedPromotionShortlist": {
      "type": "object",
      "required": [
        "schema_version",
        "study_identity",
        "selection_policy",
        "candidate_counts",
        "selected"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "study_identity": {
          "$ref": "#/$defs/studyIdentity"
        },
        "selection_policy": {
          "type": "object"
        },
        "candidate_counts": {
          "type": "object"
        },
        "selected": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "promotion_rank",
              "selection_reason",
              "architecture_signature",
              "stability_evidence",
              "promotion_config_hash",
              "parameters",
              "health_passed",
              "seed_confirmation"
            ]
          }
        }
      }
    },
    "retrospectiveControlFalsePruningRisk": {
      "type": "object",
      "required": [
        "schema_version",
        "study_identity",
        "analysis_type",
        "analysis_scope",
        "not_an_actual_pruner_replay",
        "warning",
        "comparison_rule",
        "candidate_reference",
        "control_count",
        "controls"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "study_identity": {
          "$ref": "#/$defs/studyIdentity"
        },
        "analysis_type": {
          "const": "retrospective_control_false_pruning_risk"
        },
        "analysis_scope": {
          "const": "retrospective_diagnostic_only"
        },
        "not_an_actual_pruner_replay": {
          "const": true
        },
        "warning": {
          "type": "string",
          "minLength": 1
        },
        "comparison_rule": {
          "type": "string",
          "minLength": 1
        },
        "candidate_reference": {
          "type": "object",
          "required": [
            "scope",
            "step_500_observation_count",
            "step_500_mqar_accuracy_median",
            "observations"
          ]
        },
        "control_count": {
          "type": "integer",
          "minimum": 0
        },
        "controls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "control_name",
              "architecture_modes",
              "run_count",
              "step_500_observation_count",
              "step_500_mqar_accuracy_median",
              "below_candidate_median_count",
              "retrospective_risk_label",
              "runs"
            ]
          }
        }
      }
    },
    "hypothesesReport": {
      "type": "object",
      "required": [
        "schema_version",
        "report_status",
        "decision_rule",
        "hypotheses"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "report_status": {
          "const": "scientist_review_required"
        },
        "decision_rule": {
          "type": "string",
          "minLength": 1
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "statement",
              "falsification_rule",
              "review_status",
              "falsified"
            ],
            "properties": {
              "falsified": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    "wandbPayload": {
      "type": "object",
      "required": [
        "schema_version",
        "kind",
        "network_write_performed",
        "publication_status",
        "published_report_url",
        "study_identity",
        "sampling_warning",
        "tables",
        "recommended_panels"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "wandb_report_payload"
        },
        "network_write_performed": {
          "const": false
        },
        "publication_status": {
          "const": "manual_authorized_upload_required"
        },
        "published_report_url": {
          "type": "null"
        },
        "study_identity": {
          "$ref": "#/$defs/studyIdentity"
        },
        "sampling_warning": {
          "type": "string",
          "minLength": 1
        },
        "tables": {
          "type": "object"
        },
        "recommended_panels": {
          "type": "array"
        }
      }
    },
    "studyIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_name",
        "spec_hash",
        "code_commit",
        "code_dirty",
        "data_hash",
        "capability_hash"
      ],
      "properties": {
        "study_name": {
          "type": "string",
          "minLength": 1
        },
        "spec_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "code_commit": {
          "type": "string",
          "minLength": 7
        },
        "code_dirty": {
          "const": false
        },
        "data_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capability_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
