{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "echo.phase2.reviewed_falsified_hypotheses.schema.json",
  "title": "Echo Phase 2a reviewed falsified-hypotheses receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "analysis_artifact",
    "storage_snapshot_receipt_artifact",
    "review_input_artifact",
    "study_identity",
    "study_identity_sha256",
    "expected_hypothesis_ids",
    "reviewer",
    "reviewed_at_utc",
    "decision_count",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "phase2a_reviewed_falsified_hypotheses"
    },
    "analysis_artifact": {
      "$ref": "#/$defs/artifact"
    },
    "storage_snapshot_receipt_artifact": {
      "$ref": "#/$defs/artifact"
    },
    "review_input_artifact": {
      "$ref": "#/$defs/artifact"
    },
    "study_identity": {
      "$ref": "#/$defs/studyIdentity"
    },
    "study_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "expected_hypothesis_ids": {
      "type": "array",
      "prefixItems": [
        {
          "const": "rank_scales_with_width"
        },
        {
          "const": "ska_fraction_and_placement"
        },
        {
          "const": "chunk_size_matters"
        },
        {
          "const": "differential_lr_ratios_transfer"
        },
        {
          "const": "ridge_1e3_is_sufficient"
        },
        {
          "const": "beta_initialization"
        },
        {
          "const": "layerscale_initialization"
        },
        {
          "const": "short_conv_design"
        },
        {
          "const": "qknorm_required"
        },
        {
          "const": "birdie_objectives_dominate"
        }
      ],
      "items": false,
      "minItems": 10,
      "maxItems": 10
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "decision_count": {
      "const": 10
    },
    "decisions": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/decision"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "sha256",
        "byte_size"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "studyIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_name",
        "spec_hash",
        "code_commit",
        "code_dirty",
        "data_hash",
        "capability_hash"
      ],
      "properties": {
        "study_name": {
          "type": "string",
          "minLength": 1
        },
        "spec_hash": {
          "$ref": "#/$defs/sha256"
        },
        "code_commit": {
          "type": "string",
          "minLength": 7
        },
        "code_dirty": {
          "const": false
        },
        "data_hash": {
          "$ref": "#/$defs/sha256"
        },
        "capability_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "falsified",
        "rationale",
        "evidence_trial_hashes"
      ],
      "properties": {
        "id": {
          "enum": [
            "rank_scales_with_width",
            "ska_fraction_and_placement",
            "chunk_size_matters",
            "differential_lr_ratios_transfer",
            "ridge_1e3_is_sufficient",
            "beta_initialization",
            "layerscale_initialization",
            "short_conv_design",
            "qknorm_required",
            "birdie_objectives_dominate"
          ]
        },
        "falsified": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence_trial_hashes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  }
}
