{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "echo.phase2.step_metrics.schema.json",
  "title": "Echo Phase 2 step metrics",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "trial_hash",
    "status"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "required": [
          "optimizer_step",
          "tokens_seen",
          "gpu_seconds_actual",
          "gpu_hours_actual",
          "wandb_run_id",
          "mqar_accuracy",
          "mqar_hard_accuracy",
          "mqar_worst_cell_accuracy",
          "mqar_worst_cell",
          "mqar_seed",
          "mqar_generator_revision",
          "mqar_samples_per_cell",
          "mqar_grid",
          "model_accounting",
          "optimizer_group_audit",
          "diagnostics",
          "diagnostics_by_layer"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "required": [
          "gpu_seconds_actual",
          "gpu_hours_actual",
          "failure"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          },
          "optimizer_step": {
            "const": 500
          }
        },
        "required": [
          "status",
          "optimizer_step"
        ]
      },
      "then": {
        "required": [
          "checkpoint_provenance"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          },
          "optimizer_step": {
            "minimum": 501
          }
        },
        "required": [
          "status",
          "optimizer_step"
        ]
      },
      "then": {
        "required": [
          "resume_provenance"
        ]
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "trial_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "ok",
        "failed"
      ]
    },
    "optimizer_step": {
      "type": "integer",
      "minimum": 0
    },
    "tokens_seen": {
      "type": "integer",
      "minimum": 0
    },
    "gpu_seconds_actual": {
      "type": "number",
      "minimum": 0
    },
    "gpu_hours_actual": {
      "type": "number",
      "minimum": 0
    },
    "wandb_run_id": {
      "type": "string",
      "minLength": 1
    },
    "mqar_accuracy": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "mqar_hard_accuracy": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "mqar_worst_cell_accuracy": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "mqar_worst_cell": {
      "enum": [
        "length_1024/pairs_32",
        "length_1024/pairs_64",
        "length_2048/pairs_32",
        "length_2048/pairs_64"
      ]
    },
    "mqar_seed": {
      "type": "integer"
    },
    "mqar_generator_revision": {
      "type": "string",
      "minLength": 1
    },
    "mqar_samples_per_cell": {
      "type": "integer",
      "minimum": 1
    },
    "checkpoint_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_sha256",
        "checkpoint_bundle_path",
        "checkpoint_bundle_byte_size",
        "checkpoint_bundle_file_count",
        "checkpoint_digest_algorithm",
        "optimizer_step",
        "global_sequence_index",
        "checkpoint_format_revision"
      ],
      "properties": {
        "checkpoint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "checkpoint_bundle_path": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint_bundle_byte_size": {
          "type": "integer",
          "minimum": 1
        },
        "checkpoint_bundle_file_count": {
          "type": "integer",
          "minimum": 1
        },
        "checkpoint_digest_algorithm": {
          "const": "sha256(path_nul_size_nul_content_sha256_newline_v1)"
        },
        "optimizer_step": {
          "const": 500
        },
        "global_sequence_index": {
          "type": "integer",
          "minimum": 1
        },
        "checkpoint_format_revision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resume_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_checkpoint_sha256",
        "source_checkpoint_bundle_path",
        "source_checkpoint_bundle_byte_size",
        "source_checkpoint_bundle_file_count",
        "source_checkpoint_digest_algorithm",
        "source_optimizer_step",
        "restored_global_sequence_index",
        "checkpoint_format_revision",
        "optimizer_state_restored",
        "scheduler_state_restored",
        "rng_state_restored",
        "data_stream_state_restored"
      ],
      "properties": {
        "source_checkpoint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_checkpoint_bundle_path": {
          "type": "string",
          "minLength": 1
        },
        "source_checkpoint_bundle_byte_size": {
          "type": "integer",
          "minimum": 1
        },
        "source_checkpoint_bundle_file_count": {
          "type": "integer",
          "minimum": 1
        },
        "source_checkpoint_digest_algorithm": {
          "const": "sha256(path_nul_size_nul_content_sha256_newline_v1)"
        },
        "source_optimizer_step": {
          "const": 500
        },
        "restored_global_sequence_index": {
          "type": "integer",
          "minimum": 1
        },
        "checkpoint_format_revision": {
          "type": "string",
          "minLength": 1
        },
        "optimizer_state_restored": {
          "const": true
        },
        "scheduler_state_restored": {
          "const": true
        },
        "rng_state_restored": {
          "const": true
        },
        "data_stream_state_restored": {
          "const": true
        }
      }
    },
    "wikitext_ppl": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "mqar_grid": {
      "type": "object",
      "description": "All 20 fixed sequence-length x key-value-count cells."
    },
    "model_accounting": {
      "$ref": "#/$defs/modelAccounting"
    },
    "optimizer_group_audit": {
      "$ref": "#/$defs/optimizerGroupAudit"
    },
    "diagnostics": {
      "type": "object",
      "required": [
        "spectral_radius_raw_preclamp",
        "spectral_radius_normalized_pre_gamma",
        "spectral_radius_applied_post_gamma",
        "clamp_factor_mean",
        "clamp_fraction",
        "spectral_gap_mean",
        "spectral_gap_max",
        "lambda_min_gram",
        "ridge_condition_number",
        "ridge_escalation_count",
        "ridge_requested",
        "effective_ridge_min",
        "effective_ridge_max",
        "beta_mean",
        "beta_saturation_fraction",
        "layerscale_magnitude_mean",
        "ska_branch_norm_ratio",
        "ska_gradient_to_mamba_ratio",
        "effective_jacobian_rank",
        "step_time_ms",
        "peak_memory_bytes"
      ],
      "properties": {
        "spectral_radius_raw_preclamp": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "spectral_radius_normalized_pre_gamma": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "spectral_radius_applied_post_gamma": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "clamp_factor_mean": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "clamp_fraction": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "spectral_gap_mean": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "spectral_gap_max": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "lambda_min_gram": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "ridge_condition_number": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1
        },
        "ridge_escalation_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "ridge_requested": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "effective_ridge_min": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "effective_ridge_max": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "beta_mean": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "beta_saturation_fraction": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "layerscale_magnitude_mean": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "ska_branch_norm_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "ska_gradient_to_mamba_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "effective_jacobian_rank": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "step_time_ms": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "peak_memory_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "ppl_full": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "ppl_ska_zero": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "ppl_mamba_zero": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "ppl_both_zero": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "ska_zero_ppl_delta": {
          "type": [
            "number",
            "null"
          ]
        },
        "state_rebuild_decode_prefill_max_abs_error": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "chunk_boundary_parallel_decode_max_abs_error": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "within_chunk_parallel_decode_drift_max_abs_error": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "diagnostics_by_layer": {
      "type": "object",
      "description": "Keys are realized zero-based SKA layer indices; each value contains per_head and layer records.",
      "patternProperties": {
        "^[0-9]+$": {
          "$ref": "#/$defs/layerDiagnostics"
        }
      },
      "additionalProperties": false
    },
    "not_applicable_diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "failure": {
      "type": "object",
      "required": [
        "scope",
        "code",
        "detail"
      ],
      "properties": {
        "scope": {
          "enum": [
            "trial",
            "systemic"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "nonnegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "modelAccounting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter_counts_actual",
        "parameter_estimator",
        "flops",
        "scale_band"
      ],
      "properties": {
        "parameter_counts_actual": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "embedding",
            "non_embedding_core",
            "total"
          ],
          "properties": {
            "embedding": {
              "type": "integer",
              "minimum": 0
            },
            "non_embedding_core": {
              "type": "integer",
              "minimum": 1
            },
            "total": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "parameter_estimator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "core_relative_error",
            "total_relative_error",
            "maximum_allowed_relative_error",
            "outcome"
          ],
          "properties": {
            "core_relative_error": {
              "$ref": "#/$defs/nonnegativeNumber"
            },
            "total_relative_error": {
              "$ref": "#/$defs/nonnegativeNumber"
            },
            "maximum_allowed_relative_error": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "outcome": {
              "enum": [
                "within_tolerance",
                "exceeded"
              ]
            }
          }
        },
        "flops": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "estimated",
            "measured",
            "measurement_steps",
            "estimator_method",
            "measurement_method",
            "relative_error",
            "maximum_allowed_relative_error",
            "outcome"
          ],
          "properties": {
            "scope": {
              "const": "training_forward_backward_per_optimizer_step"
            },
            "estimated": {
              "$ref": "#/$defs/positiveNumber"
            },
            "measured": {
              "$ref": "#/$defs/positiveNumber"
            },
            "measurement_steps": {
              "type": "integer",
              "minimum": 1
            },
            "estimator_method": {
              "type": "string",
              "minLength": 1
            },
            "measurement_method": {
              "type": "string",
              "minLength": 1
            },
            "relative_error": {
              "$ref": "#/$defs/nonnegativeNumber"
            },
            "maximum_allowed_relative_error": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "outcome": {
              "enum": [
                "within_tolerance",
                "exceeded"
              ]
            }
          }
        },
        "scale_band": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "accounting",
            "accepted_min",
            "accepted_max",
            "actual_value",
            "outcome"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "accounting": {
              "const": "non_embedding_trainable_parameters"
            },
            "accepted_min": {
              "type": "integer",
              "minimum": 1
            },
            "accepted_max": {
              "type": "integer",
              "minimum": 1
            },
            "actual_value": {
              "type": "integer",
              "minimum": 1
            },
            "outcome": {
              "enum": [
                "within_band",
                "outside_band"
              ]
            }
          }
        }
      }
    },
    "optimizerParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "numel"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "numel": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "optimizerGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_name",
        "manifest_group_name",
        "lr",
        "weight_decay",
        "parameters",
        "tensor_count",
        "scalar_parameter_count",
        "parameter_digest"
      ],
      "properties": {
        "group_name": {
          "type": "string",
          "minLength": 1
        },
        "manifest_group_name": {
          "type": "string",
          "minLength": 1
        },
        "lr": {
          "$ref": "#/$defs/positiveNumber"
        },
        "weight_decay": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "parameters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/optimizerParameter"
          }
        },
        "tensor_count": {
          "type": "integer",
          "minimum": 1
        },
        "scalar_parameter_count": {
          "type": "integer",
          "minimum": 1
        },
        "parameter_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "optimizerGroupAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groups",
        "coverage",
        "trainable_parameter_digest",
        "coverage_digest"
      ],
      "properties": {
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/optimizerGroup"
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trainable_parameter_tensor_count",
            "assigned_parameter_tensor_count",
            "trainable_scalar_parameter_count",
            "assigned_scalar_parameter_count",
            "unassigned_parameter_names",
            "duplicate_parameter_names",
            "complete",
            "exclusive"
          ],
          "properties": {
            "trainable_parameter_tensor_count": {
              "type": "integer",
              "minimum": 1
            },
            "assigned_parameter_tensor_count": {
              "type": "integer",
              "minimum": 1
            },
            "trainable_scalar_parameter_count": {
              "type": "integer",
              "minimum": 1
            },
            "assigned_scalar_parameter_count": {
              "type": "integer",
              "minimum": 1
            },
            "unassigned_parameter_names": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "duplicate_parameter_names": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "complete": {
              "type": "boolean"
            },
            "exclusive": {
              "type": "boolean"
            }
          }
        },
        "trainable_parameter_digest": {
          "$ref": "#/$defs/sha256"
        },
        "coverage_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "layerDiagnostics": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "per_head",
        "layer"
      ],
      "properties": {
        "per_head": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/headDiagnostics"
          }
        },
        "layer": {
          "$ref": "#/$defs/perLayerDiagnostics"
        }
      }
    },
    "headDiagnostics": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "spectral_radius_raw_preclamp_mean",
        "spectral_radius_raw_preclamp_max",
        "spectral_radius_normalized_pre_gamma_mean",
        "spectral_radius_normalized_pre_gamma_max",
        "spectral_radius_applied_post_gamma_mean",
        "spectral_radius_applied_post_gamma_max",
        "clamp_factor_mean",
        "clamp_fraction",
        "spectral_gap_mean",
        "spectral_gap_max",
        "lambda_min_gram_mean",
        "lambda_min_gram_min",
        "ridge_condition_number_mean",
        "ridge_condition_number_max",
        "ridge_escalation_count",
        "effective_ridge_min",
        "effective_ridge_max"
      ],
      "properties": {
        "spectral_radius_raw_preclamp_mean": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "spectral_radius_raw_preclamp_max": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "spectral_radius_normalized_pre_gamma_mean": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "spectral_radius_normalized_pre_gamma_max": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "spectral_radius_applied_post_gamma_mean": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "spectral_radius_applied_post_gamma_max": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "clamp_factor_mean": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "clamp_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "spectral_gap_mean": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "spectral_gap_max": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "lambda_min_gram_mean": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "lambda_min_gram_min": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "ridge_condition_number_mean": {
          "type": "number",
          "minimum": 1
        },
        "ridge_condition_number_max": {
          "type": "number",
          "minimum": 1
        },
        "ridge_escalation_count": {
          "type": "integer",
          "minimum": 0
        },
        "effective_ridge_min": {
          "$ref": "#/$defs/positiveNumber"
        },
        "effective_ridge_max": {
          "$ref": "#/$defs/positiveNumber"
        }
      }
    },
    "perLayerDiagnostics": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "residual_norm_ratio",
        "gradient_norm_ratio",
        "effective_jacobian_rank",
        "beta_mean",
        "beta_saturation_fraction",
        "layerscale_magnitude_mean"
      ],
      "properties": {
        "residual_norm_ratio": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "gradient_norm_ratio": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "effective_jacobian_rank": {
          "$ref": "#/$defs/nonnegativeNumber"
        },
        "beta_mean": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "beta_saturation_fraction": {
