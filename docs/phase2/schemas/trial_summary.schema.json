{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "echo.phase2.trial_summary.schema.json",
  "title": "Echo Phase 2 trial summary",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "trial_hash",
    "promotion_config_hash",
    "study_identity",
    "seed",
    "status",
    "mqar_accuracy",
    "wikitext_ppl",
    "wandb_run_id",
    "optuna_trial_id",
    "health_passed",
    "gpu_seconds_actual",
    "gpu_hours_actual"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "COMPLETE",
              "SCREEN_COMPLETE",
              "PRUNED"
            ]
          }
        }
      },
      "then": {
        "required": [
          "model_accounting",
          "optimizer_group_audit"
        ],
        "properties": {
          "wandb_run_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "trial_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "promotion_config_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "study_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_name",
        "spec_hash",
        "code_commit",
        "code_dirty",
        "data_hash",
        "capability_hash"
      ],
      "properties": {
        "study_name": {
          "type": "string",
          "minLength": 1
        },
        "spec_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "code_commit": {
          "type": "string",
          "minLength": 7
        },
        "code_dirty": {
          "const": false
        },
        "data_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "capability_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "seed": {
      "type": "integer"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "SCREEN_COMPLETE",
        "PRUNED",
        "FAIL"
      ]
    },
    "mqar_accuracy": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "step_500_mqar_accuracy": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "wikitext_ppl": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "wandb_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "optuna_trial_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "health_passed": {
      "type": "boolean"
    },
    "parameters": {
      "type": "object",
      "description": "Optional merged Optuna parameters used for promotion diversity."
    },
    "model_accounting": {
      "$ref": "echo.phase2.step_metrics.schema.json#/$defs/modelAccounting"
    },
    "optimizer_group_audit": {
      "$ref": "echo.phase2.step_metrics.schema.json#/$defs/optimizerGroupAudit"
    },
    "gpu_seconds_actual": {
      "type": "number",
      "minimum": 0
    },
    "gpu_hours_actual": {
      "type": "number",
      "minimum": 0
    },
    "gpu_time_source": {
      "type": "string",
      "minLength": 1
    },
    "stability_passed": {
      "type": "boolean",
      "description": "Optional seeded stability gate for final promotion."
    },
    "failure": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
