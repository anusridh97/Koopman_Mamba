{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koopman-mamba.local/schemas/phase2/storage-snapshot-receipt-v1.json",
  "title": "Phase 2 Optuna storage snapshot receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "study_identity",
    "analysis_artifact",
    "ledger_contract_artifact",
    "storage",
    "quiescence_evidence",
    "created_by",
    "created_at_utc"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "receipt_kind": {
      "const": "phase2_optuna_storage_snapshot"
    },
    "study_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "study_name",
        "requested_trials",
        "spec_canonical_sha256",
        "spec_file"
      ],
      "properties": {
        "study_name": {
          "type": "string",
          "minLength": 1
        },
        "requested_trials": {
          "type": "integer",
          "minimum": 1
        },
        "spec_canonical_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "spec_file": {
          "$ref": "#/$defs/fileIdentity"
        }
      }
    },
    "analysis_artifact": {
      "$ref": "#/$defs/fileIdentity"
    },
    "ledger_contract_artifact": {
      "$ref": "#/$defs/fileIdentity"
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "snapshot_file",
        "backend_validation"
      ],
      "properties": {
        "backend": {
          "enum": [
            "postgresql",
            "scg_validated_journal_storage"
          ]
        },
        "snapshot_file": {
          "$ref": "#/$defs/fileIdentity"
        },
        "backend_validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "entry_count",
            "listing_sha256"
          ],
          "properties": {
            "method": {
              "enum": [
                "pg_restore_list",
                "safe_tar_member_inventory"
              ]
            },
            "entry_count": {
              "type": "integer",
              "minimum": 1
            },
            "listing_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "quiescence_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status_file",
        "completion_disposition",
        "budget_exhausted_early_stop_approval",
        "claim_count",
        "running_claims",
        "recovery_queued_claims",
        "terminal_gpu_hours_actual",
        "active_gpu_hours_reserved",
        "remaining_unreserved_gpu_hours",
        "maximum_full_trial_gpu_hours",
        "compute_budget_violation_count",
        "status_hold_reasons",
        "fresh_optuna_trial_count",
        "fresh_trial_target_guard_count",
        "optuna_trial_count",
        "optuna_states"
      ],
      "properties": {
        "status_file": {
          "$ref": "#/$defs/fileIdentity"
        },
        "completion_disposition": {
          "enum": [
            "requested_trial_target_reached",
            "approved_budget_exhausted_early_stop"
          ]
        },
        "budget_exhausted_early_stop_approval": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/budgetExhaustedEarlyStopApproval"
            }
          ]
        },
        "claim_count": {
          "type": "integer",
          "minimum": 0
        },
        "running_claims": {
          "const": 0
        },
        "recovery_queued_claims": {
          "const": 0
        },
        "terminal_gpu_hours_actual": {
          "type": "number",
          "minimum": 0
        },
        "active_gpu_hours_reserved": {
          "const": 0.0
        },
        "remaining_unreserved_gpu_hours": {
          "type": "number",
          "minimum": 0
        },
        "maximum_full_trial_gpu_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "compute_budget_violation_count": {
          "const": 0
        },
        "status_hold_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "fresh_optuna_trial_count": {
          "type": "integer",
          "minimum": 0
        },
        "fresh_trial_target_guard_count": {
          "type": "integer",
          "minimum": 0
        },
        "optuna_trial_count": {
          "type": "integer",
          "minimum": 1
        },
        "optuna_states": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "completion_disposition": {
                "const": "requested_trial_target_reached"
              }
            }
          },
          "then": {
            "properties": {
              "budget_exhausted_early_stop_approval": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "budget_exhausted_early_stop_approval": {
                "$ref": "#/$defs/budgetExhaustedEarlyStopApproval"
              }
            }
          }
        }
      ]
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "$defs": {
    "budgetExhaustedEarlyStopApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_by",
        "approved_at_utc",
        "approved_fresh_optuna_trial_count",
        "requested_trials",
        "remaining_unreserved_gpu_hours",
        "maximum_full_trial_gpu_hours"
      ],
      "properties": {
        "approved_by": {
          "type": "string",
          "minLength": 1
        },
        "approved_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "approved_fresh_optuna_trial_count": {
          "type": "integer",
          "minimum": 0
        },
        "requested_trials": {
          "type": "integer",
          "minimum": 1
        },
        "remaining_unreserved_gpu_hours": {
          "type": "number",
          "minimum": 0
        },
        "maximum_full_trial_gpu_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
